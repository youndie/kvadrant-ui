# The style lives here rather than in the plugin defaults: otherwise it shifts when the plugin is
# bumped instead of when we decide to change it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official

# A composable is named like a type, not like a function, and Compose reads that way everywhere.
# The exemption targets the annotation, not the file: an ordinary function in the same source is
# still held to camel case.
ktlint_function_naming_ignore_when_annotated_with = Composable

# No star imports. A wildcard hides which module a name came from, and this library deliberately
# carries names that shadow Material ones.
ij_kotlin_packages_to_use_import_on_demand = false
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown uses trailing spaces for hard line breaks; trimming them silently reflows documents.
trim_trailing_whitespace = false

# Generated sources are rewritten on every build and must not be edited, so a formatter running on
# them would fail a build nobody can fix. The ktlint plugin's own filters do not reach here: it
# fixes the file list before this setting would apply.
[**/build/**.kt]
ktlint = disabled
