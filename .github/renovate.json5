{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended"],

  // Once a week, in UTC. Updates arrive as one Monday-morning batch rather than a trickle of a PR
  // a day — every pull request here runs the full check, screenshots included, and that is not
  // cheap.
  timezone: "Etc/UTC",
  schedule: ["before 6am on monday"],

  // Commits here are Conventional Commits, and a hook enforces it. `config:recommended` maps
  // dependency bumps to `fix:` and everything else to `chore:`.
  semanticCommits: "enabled",

  labels: ["dependencies"],

  // With the build harness merging itself these numbers stop being a throttle on human attention
  // and become one on runner time, so they can be higher.
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Renovate merges the pull request itself rather than arming GitHub's auto-merge: GitHub refuses
  // to arm it on a branch with no required checks, and adding branch protection to `main` would
  // change how this repository is worked in.
  platformAutomerge: false,

  // Vulnerabilities are the one thing that ignores the schedule.
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    labels: ["dependencies", "security"],
  },

  // kotlin-js-store holds a lock file the Kotlin/Wasm plugin generates for itself.
  ignorePaths: ["**/build/**", "**/.gradle/**", "**/kotlin-js-store/**"],

  packageRules: [
    {
      description: "Kotlin: the compiler and its plugins move as one version, and that is never a routine bump",
      matchPackageNames: ["/^org\\.jetbrains\\.kotlin[:.]/"],
      groupName: "kotlin",
    },
    {
      description: "kotlinx ships as one release train — one PR",
      matchPackageNames: ["/^org\\.jetbrains\\.kotlinx[:.]/"],
      groupName: "kotlinx",
    },
    {
      // The build conventions are one release published under two names: the catalog entry
      // `sborka` (the plugin coordinates) and the settings plugin id resolved in
      // settings.gradle.kts. Without this they arrive as two pull requests for one number, which
      // is what happens today in the repositories that migrated first.
      description: "sborka is one release, not one release per place it is named",
      matchPackageNames: [
        "/^ru\\.workinprogress\\.sborka/",
        // The catalog's `sborka` version is read from the GitHub releases of the repository that
        // publishes the plugins, so Renovate knows the same release under a second name. Without
        // this line it arrives as a second pull request for the same number — which is exactly
        // what the repositories that migrated first are living with today.
        "youndie/sborka",
      ],
      groupName: "sborka",
    },
    {
      // Anything that can move a pixel. The 126 files under `src/desktopTest/snapshots` are the
      // check, so a Compose bump is expected to fail it — that failure is the signal, not a flake.
      // Re-record and read the diff before merging.
      description: "Compose Multiplatform and everything that releases with it",
      matchPackageNames: [
        // The plugin is named by its id, with nothing after it — a pattern that demands a `:` or
        // a `.` next matches the artefacts and misses the plugin that sets their version.
        "org.jetbrains.compose",
        "/^org\\.jetbrains\\.compose[:.]/",
        "/^org\\.jetbrains\\.androidx\\./",
      ],
      groupName: "compose multiplatform",
      addLabels: ["goldens-may-change"],
    },
    {
      // The Material3 line for Compose Multiplatform ships as prereleases well past the stable
      // compose-multiplatform version — `material3:1.12.0-alpha03` is what CMP 1.12.0 releases
      // itself with — so the usual "stable only" rule would pin it forever.
      matchPackageNames: ["/^org\\.jetbrains\\.compose\\.material3[:.]/"],
      ignoreUnstable: false,
    },
    {
      // viddik ships the plugin, the annotations and the capture engine under one version, and a
      // half-moved set is the failure mode. Same label as Compose: it renders the goldens.
      description: "viddik is one release across the plugin, the annotations and the engine",
      matchPackageNames: ["/^ru\\.workinprogress\\.viddik/"],
      groupName: "viddik",
      addLabels: ["goldens-may-change"],
    },
    {
      description: "The build harness arrives as one PR, not one per action",
      matchManagers: ["github-actions"],
      groupName: "ci actions",
    },
    {
      // The plugin and the CLI it runs are separate versions on purpose, and the catalog says so.
      // Both are build tooling: nothing they touch ships.
      description: "ktlint is build tooling, not a runtime dependency",
      matchPackageNames: [
        // The Gradle plugin is named by its id, with nothing after it — a pattern that demands a
        // `:` or a `.` next matches the coordinate and misses the plugin entirely.
        "org.jlleitschuh.gradle.ktlint",
        "/^com\\.pinterest\\.ktlint[:.]/",
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "Majors of anything that ships get a human",
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major"],
    },
    // Last, so it wins over the major rule above. A major of `actions/checkout` is not the same
    // kind of event as a major of Compose: the build harness is not shipped to anyone, and the
    // check that would catch a bad bump is the build itself — which already ran on the PR.
    {
      description: "The build harness merges itself, majors included: CI on pull_request is the review",
      matchManagers: ["github-actions", "gradle-wrapper"],
      automerge: true,
      automergeType: "pr",
    },
  ],
}
