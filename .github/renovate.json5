{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The portfolio's shared configuration, extended by name: the timezone, the Monday schedule, the
  // limits, `platformAutomerge: false`, the kotlin/kotlinx/sborka/ci-actions groups and majors going
  // to a human were identical in ten repositories and now live in sborka.
  //
  // The automerge preset is extended second on purpose — its rule has to land after the base
  // preset's "majors get a human" to override it for the harness — and its precondition holds
  // here: check.yaml runs on `pull_request`.
  extends: [
    "github>youndie/sborka",
    "github>youndie/sborka:automerge-harness",
  ],

  // REPEATED IN FULL, not added to: `ignorePaths` is replaced by this value rather than merged with
  // the preset's, so dropping the first two would un-ignore them. kotlin-js-store holds a lock file
  // the Kotlin/Wasm plugin generates for itself.
  ignorePaths: ["**/build/**", "**/.gradle/**", "**/kotlin-js-store/**"],

  // Below the extends, so these win: package rules are concatenated, preset first, and the last
  // match takes effect.
  packageRules: [
    {
      // Anything that can move a pixel. The 126 files under `src/desktopTest/snapshots` are the
      // check, so a Compose bump is expected to fail it — that failure is the signal, not a flake.
      // Re-record and read the diff before merging.
      description: "Compose Multiplatform and everything that releases with it",
      matchPackageNames: [
        // The plugin is named by its id, with nothing after it — a pattern that demands a `:` or
        // a `.` next matches the artefacts and misses the plugin that sets their version.
        "org.jetbrains.compose",
        "/^org\\.jetbrains\\.compose[:.]/",
        "/^org\\.jetbrains\\.androidx\\./",
      ],
      groupName: "compose multiplatform",
      addLabels: ["goldens-may-change"],
    },
    {
      // The Material3 line for Compose Multiplatform ships as prereleases well past the stable
      // compose-multiplatform version — `material3:1.12.0-alpha03` is what CMP 1.12.0 releases
      // itself with — so the usual "stable only" rule would pin it forever.
      matchPackageNames: ["/^org\\.jetbrains\\.compose\\.material3[:.]/"],
      ignoreUnstable: false,
    },
    {
      // viddik ships the plugin, the annotations and the capture engine under one version, and a
      // half-moved set is the failure mode. Same label as Compose: it renders the goldens.
      //
      // BOTH GROUP NAMES, for the reason the preset names both sborka groups: this repository pins
      // `ru.workinprogress.viddik` while viddik itself now publishes under `io.github.youndie.viddik`
      // (its `sborka.group`). A rule naming only the old one keeps working until the day this
      // repository migrates, and then stops matching without saying anything — which is the
      // half-moved set this rule exists to prevent.
      description: "viddik is one release across the plugin, the annotations and the engine",
      matchPackageNames: [
        "/^ru\\.workinprogress\\.viddik/",
        "/^io\\.github\\.youndie\\.viddik/",
      ],
      groupName: "viddik",
      addLabels: ["goldens-may-change"],
    },
    {
      // The plugin and the CLI it runs are separate versions on purpose, and the catalog says so.
      // Both are build tooling: nothing they touch ships.
      description: "ktlint is build tooling, not a runtime dependency",
      matchPackageNames: [
        // The Gradle plugin is named by its id, with nothing after it — a pattern that demands a
        // `:` or a `.` next matches the coordinate and misses the plugin entirely.
        "org.jlleitschuh.gradle.ktlint",
        "/^com\\.pinterest\\.ktlint[:.]/",
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
  ],
}
